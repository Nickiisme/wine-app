page { background: #f6f7f9; color: #17202a; }
.container { padding: 32rpx; line-height: 1.6; }
.title { font-size: 36rpx; font-weight: bold; margin-bottom: 16rpx; }
.intro { margin-bottom: 28rpx; }
.field-label { margin-top: 20rpx; font-weight: bold; }
.field { box-sizing: border-box; height: 96rpx; padding: 16rpx 24rpx; border: 2rpx solid #697586; border-radius: 12rpx; background: #fff; color: #17202a; font-size: 30rpx; }
button { margin: 24rpx 0; }
.diagnostics { display: block; white-space: pre-wrap; font-family: monospace; font-size: 24rpx; overflow-wrap: break-word; }
.note { margin-top: 24rpx; color: #505968; }
.error { color: #ad1c1c; margin-top: 16rpx; }
